---
import Header from "../components/shared/Header.astro";
import Footer from "../components/shared/Footer.astro";
import CookieConsent from "../components/shared/CookieConsent.astro";
import IndexBg from "../components/shared/IndexBg.astro";
import vigilguardBlogLogo from "../assets/vigilguard-blog.svg";
import "../styles/style.css";

const { title, description, socialTitle, frontmatter, isWide } = Astro.props;

const path = Astro.url.pathname.replace(/\/$/, "");
const segments = path.split("/").filter(Boolean);
const isBlogPost =
  segments.length >= 2 &&
  (segments[0] === "blog" || segments[0] === "learning");

const displayTitle = frontmatter?.title || title;
const displayDescription = frontmatter?.description || description ||
  "VigilGuard is the system of readiness for external risk. Continuous external attack surface management (EASM), vendor risk management, and crisis readiness in one platform.";
const date = frontmatter?.date || "";
const pathname = Astro.url.pathname;
---

<html lang="en">
  <head>
    <!-- Google Consent Mode default — must run before GTM/GA script tags -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag("consent", "default", {
        analytics_storage: "denied",
        ad_storage: "denied",
        ad_user_data: "denied",
        ad_personalization: "denied",
      });
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{displayTitle} | VigilGuard</title>

    <link rel="icon" href="/favicon.svg" />
    <link rel="canonical" href={Astro.url.href} />
    <meta name="description" content={displayDescription} />
    <meta name="author" content="VigilGuard™" />

    <meta property="og:site_name" content="VigilGuard" />
    <meta property="og:type" content={isBlogPost ? "article" : "website"} />
    <meta property="og:url" content={`https://www.vigilguard.com${pathname}`} />
    <meta
      property="og:title"
      content={socialTitle ?? displayTitle ?? "VigilGuard – See What Attackers See. Be Ready Before They Act."}
    />
    <meta property="og:description" content={displayDescription} />
    <meta
      property="og:image"
      content="https://www.vigilguard.com/og-image.png"
    />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta
      name="twitter:title"
      content={socialTitle ?? displayTitle ?? "VigilGuard – See What Attackers See. Be Ready Before They Act."}
    />
    <meta name="twitter:description" content={displayDescription} />
    <meta
      name="twitter:image"
      content="https://www.vigilguard.com/og-image.png"
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap"
      />
    </noscript>

    <!-- Theme init — must be in <head> to prevent flash -->
    <script is:inline>
      (function () {
        const saved = localStorage.getItem("theme");
        const theme = saved || "light";
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>
  </head>
  <body>
    <Header />
    <IndexBg />

    {
      isBlogPost && (
        <div class="circle-back-link">
          <a
            href={segments[0] === "learning" ? "/learning" : "/blog"}
            class="circle-back-btn"
            aria-label="Back"
          >
            ←
          </a>
        </div>
      )
    }

    <main class="relative z-10">
      <article
        class={isWide
          ? "wide-container"
          : segments[0] === "learning"
            ? "learning-container"
            : "content-container"}
      >
        {
          isBlogPost && (
            <header class="post-research-header">
              <div class="terminal-meta">
                <img
                  src={vigilguardBlogLogo.src}
                  alt=""
                  width="24"
                  height="24"
                  class="blog-logo"
                />
                <span>[SYSTEM_INTEL]: {date}</span>
              </div>
              <hr class="header-divider" />
            </header>
          )
        }

        <div class="markdown-body">
          <slot />
        </div>
      </article>
    </main>

    <Footer />
    <CookieConsent />
  </body>
</html>

<style is:global>
  .wide-container {
    width: 90vw;
    max-width: 100%;
    padding: 0;
    background-color: var(--bg-primary) opacity(0.95);
    margin: 0 auto;
  }

  .markdown-body,
  .markdown-body p,
  .markdown-body li {
    font-family: "Space Grotesk", sans-serif !important;
    font-size: 18px !important;
    line-height: 1.8 !important;
    color: var(--text-primary) !important;
  }

  .markdown-body h1,
  .markdown-body h2,
  .markdown-body h3 {
    font-family: "Space Grotesk", sans-serif !important;
    font-weight: 700 !important;
  }

  .post-research-header {
    padding: 30px 30px 0 30px;
  }

  .terminal-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: "Space Grotesk", monospace !important;
    color: var(--brand-purple);
    font-size: 13px;
    margin-bottom: 10px;
    margin-top: 40px;
  }

  .blog-logo {
    opacity: 0.85;
    flex-shrink: 0;
  }

  .header-divider {
    border: 0;
    height: 1px;
    background: linear-gradient(to right, var(--brand-purple), transparent);
    margin: 20px 0;
    opacity: 0.5;
  }

  /* Back Button */
  .circle-back-link {
    position: fixed;
    bottom: 30px;
    left: 30px;
    z-index: 2000;
  }

  .circle-back-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    background: var(--bg-tertiary);
    border-radius: 50%;
    color: var(--text-primary);
    text-decoration: none;
    font-size: 1.5rem;
    border: 1px solid var(--border-translucent);
    box-shadow: 0 4px 15px var(--shadow-color);
    position: relative;
    transition:
      transform 0.2s ease,
      background 0.2s ease;
    animation: btn-float 3s ease-in-out infinite;
  }

  .circle-back-btn::before {
    content: "";
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    background: conic-gradient(
      from var(--angle, 0deg),
      transparent 60%,
      var(--brand-purple) 80%,
      transparent 100%
    );
    animation: shimmer-spin 2.5s linear infinite;
    z-index: -1;
  }

  .circle-back-btn::after {
    content: "";
    position: absolute;
    inset: 1px;
    border-radius: 50%;
    background: var(--bg-tertiary);
    z-index: -1;
  }

  .circle-back-btn:hover {
    transform: scale(1.12);
    animation: none;
  }

  .circle-back-btn:active {
    transform: scale(0.93);
  }

  .learning-container {
    max-width: 760px;
    margin: 0 auto;
    padding: 60px 20px;
    background-color: var(--bg-primary);
  }

  @property --angle {
    syntax: "<angle>";
    inherits: false;
    initial-value: 0deg;
  }

  @keyframes shimmer-spin {
    to {
      --angle: 360deg;
    }
  }

  @keyframes btn-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-4px);
    }
  }

  @media (max-width: 768px) {
    .circle-back-link {
      bottom: auto;
      top: 10px;
      left: 50%;
      transform: translateX(-50%);
      z-index: 2000;
    }
    .circle-back-btn {
      width: 2.5rem;
      height: 2.5rem;
    }
  }
</style>
